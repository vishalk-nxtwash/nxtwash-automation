venv/
__pycache__/
.pytest_cache/
.env
.env.*
!.env.example

# ── Report output (all under reports/) ───────────────────────────────────────
# Single canonical location for every run artifact.
reports/allure-results/
reports/allure-report/
reports/screenshots/
reports/logs/
reports/runs/
reports/*.txt

# Keep the reports/ directory itself and its placeholder files in git.
!reports/.gitkeep

# ── Legacy / stray allure folders at project root ─────────────────────────────
# These were created before the reports/ convention was enforced.
# Safe to delete locally; they are not committed.
allure-results*/
allure-report*/

# ── Root-level report files (also produced by the old CI step) ───────────────
report.html
results.xml

# ── Old root-level screenshot / log directories ───────────────────────────────
screenshots/
logs/

# ── Misc ──────────────────────────────────────────────────────────────────────
assets/
.DS_Store
.vscode/
.idea/
--headless
